{
  "name": "beacon-credential-monitor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/initDatabase.ts && prisma migrate deploy",
    "db:generate": "prisma generate",
    "import": "node --import tsx scripts/importEmployees.ts",
    "setup": "npm run db:generate && npm run db:migrate && npm run import",
    "verify:kathryn": "node --import tsx scripts/verifyKathryn.ts",
    "postinstall": "prisma generate",
    "ai:smoke": "node --import tsx scripts/aiSmoke.ts",
    "test:ui": "node scripts/checkUi.mjs",
    "test:integration": "node tests/httpIntegration.mjs",
    "format": "prettier --write app components lib services scripts tests prisma.config.ts next.config.ts eslint.config.mjs postcss.config.mjs package.json tsconfig.json README.md",
    "test:live-ui": "node scripts/testLiveUi.mjs",
    "test:provider": "node --import tsx scripts/testProvider.mjs",
    "test:viewer": "node scripts/testVerificationViewer.mjs",
    "test:workspace": "node scripts/testWorkspace.mjs",
    "test:scraper": "node --import tsx scripts/testScraperFallback.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "openai": "^7.27.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
